#!/usr/bin/env bash

CURRENT_COMMAND=""
CURRENT_MESSAGE=""
COMMAND_HISTORY=()
COMMAND_HISTORY_POSITION="1"
COMMAND_DRAFT=""

enter_command_mode()
{
	log_debug "Entering COMMAND mode"
	CURRENT_INPUT="$CURRENT_COMMAND"
	COMMAND_HISTORY_POSITION="${#COMMAND_HISTORY[@]}"
	MODE="command"
	render_input
}

command_sort() 
{
	local sorting=$1

	if [[ -z "$sorting" ]]; then
		set_input_message "$(escape red_color)You must supply a sorting scheme$(escape default_color)"
		return 1
	fi

	case "$sorting" in
		type | size | name | mod) 
			set_input_message "Sorting by $sorting"
			set_sorting "$sorting";;
		*) set_input_message "$(escape red_color)$sorting is not a supported sorting scheme$(escape default_color)";;
	esac
}

command_hidden()
{
	local arg=$1

	# If ran with no arguments toggle
	if [ -z "$arg" ]; then
		case "$SHOW_HIDDEN" in
			'1') 
				set_input_message "Disabled showing .hidden files"
				log_debug "Disabled showing .hidden files"
				set_hidden 0;;
			'0')
				set_input_message "Enabled showing .hidden files"
				log_debug "Enabled showing .hidden files"
				set_hidden 1;;
		esac
		return 0
	fi

	case "$arg" in
		true|1|yes)
			set_input_message "Enabled showing .hidden files"
			log_debug "Enabled showing .hidden files"
			set_hidden 1
			;;
		false|0|no)
			set_input_message "Disabled showing .hidden files"
			log_debug "Disabled showing .hidden files"
			set_hidden 0
			;;
		*) set_input_message "$(escape red_color)$1 is not a supported boolean alias$(escape default_color)";;
	esac
	reset_mode
}

command_line_wrap()
{
	local arg=$1

	# If ran with no arguments toggle
	if [ -z "$arg" ]; then
		case "$HIGHLIGHT_LINE_WRAPPING" in
			'1') 
				set_input_message "Disabled line wrapping for file previews"
				log_debug "Disabled line wrapping for file previews"
				HIGHLIGHT_LINE_WRAPPING=0
				;;
			'0')
				set_input_message "Enabled line wrapping for file previews"
				log_debug "Enabled line wrapping for file previews"
				HIGHLIGHT_LINE_WRAPPING=1
				;;
		esac
		reset_mode
		directory_change
		return 0
	fi

	case "$arg" in
		true|1|yes)
			set_input_message "Disabled line wrapping for file previews"
			log_debug "Disabled line wrapping for file previews"
			HIGHLIGHT_LINE_WRAPPING=1
			;;
		false|0|no)
			set_input_message "Enabled line wrapping for file previews"
			log_debug "Enabled line wrapping for file previews"
			HIGHLIGHT_LINE_WRAPPING=0
			;;
		*) set_input_message "$(escape red_color)$1 is not a supported boolean alias$(escape default_color)";;
	esac
	reset_mode
	directory_change
}

move_command_history()
{
	local history_size="${#COMMAND_HISTORY[@]}"
	local dest="$(($COMMAND_HISTORY_POSITION + $1))"
	if [[ "$dest" -ge "$history_size" ]]; then
		CURRENT_INPUT="$COMMAND_DRAFT"
		CURRENT_COMMAND="$CURRENT_INPUT"
		dest="$history_size"
	elif [[ "$dest" -ge "0" ]]; then
		CURRENT_INPUT="${COMMAND_HISTORY[$dest]}"
		CURRENT_COMMAND="$CURRENT_INPUT"
	else
		dest="0"
	fi
	COMMAND_HISTORY_POSITION="$dest"
	render_input
}

update_command_draft()
{
	if [[ "$dest" -ge "$history_size" ]]; then
		COMMAND_DRAFT="$CURRENT_COMMAND"
	fi
}

mark_file()
{
	# Tries to mark $1 but if empty use the currently selected file
	local mark=${1:-"${CURRENT_DIR_CONTENT[$SELECTED]}"}

	if ! [ -e "$CURRENT_DIR$mark" ]; then
		set_input_message "$(escape red_color)$mark doesn't exist$(escape default_color)"
		return 1
	fi

	MARKED=$mark
	MARKED_DIR="$CURRENT_DIR"
	log_debug "Marked $MARKED_DIR$MARKED"
	set_input_message "Marked $MARKED"
	render_top
}

edit_marked()
{
	if [[ -z "$MARKED" ]]; then
		set_input_message "$(escape red_color)No file has been marked (:mark)$(escape default_color)"
		return 1
	fi

	local op=$1
	case $op in
		move)
			local dest=$2
			mv "$MARKED_DIR$MARKED" "$dest"
			MARKED_DIR="$dest"
			log_debug "Moved $MARKED_DIR$MARKED to $dest"
			set_input_message "Moved $MARKED to $dest"
			directory_change
			;;
		copy)
			local dest=$2
			local flags=()
			if [[ -d "$MARKED_DIR$MARKED" ]]; then
				flags=(-r)
			fi
			cp "${flags[@]}" "$MARKED_DIR$MARKED" "$dest"
			log_debug "Copied $MARKED_DIR$MARKED to $dest"
			set_input_message "Copied $MARKED to $dest"
			directory_change
			;;
		delete)
			rm -rf "$MARKED_DIR$MARKED"
			log_debug "Deleted $MARKED_DIR$MARKED"
			set_input_message "Deleted $MARKED"
			MARKED=""
			SELECTED=$((SELECTED - 1))
			if [[ $SELECTED -lt 0 ]]; then
				SELECTED=0
			fi

			directory_change
			;;
		toggle_executable)
			# Directories are supported too
			local file="$MARKED_DIR$MARKED"
			if [ -x "$file" ]; then
				chmod -x "$file"
				set_input_message "Removed execute permission from $MARKED"
				log_debug "Removed execute permission from $MARKED_DIR$MARKED"
			else
				chmod +x "$file"
				set_input_message "Added execute permission to $MARKED"
				log_debug "Added execute permission to $MARKED_DIR$MARKED"
			fi
			directory_change
			;;
		rename)
			local name=$2
			mv "$MARKED_DIR$MARKED" "$MARKED_DIR$name"
			log_debug "Renamed $MARKED_DIR$MARKED to $name"
			set_input_message "Renamed $MARKED to $name"
			MARKED="$name"
			directory_change
			;;
	esac
}

start_command()
{
	enter_command_mode
	CURRENT_INPUT="$1"
	render_input
}

create_command()
{
	if [ $# = 0 ]; then
		set_input_message "$(escape red_color)You must name at least one file$(escape default_color)"
		return 1
	fi

	for file in "$@"; do
		create_file_dir "$file"
	done

	if [ $# = 1 ]; then
		set_input_message "Created $1"
	else
		set_input_message "Created $# files"
	fi

	directory_change
}

create_file_dir()
{
	local path="$1"
	if [[ "$path" == */ ]]; then
		mkdir -p "$path"
	else
		mkdir -p "$(dirname "$path")"
		touch "$path"
	fi

	log_debug "Created $path"
}

get_dir_size()
{
	local dir_size
	set_input_message "Fetching directory size..."
	reset_mode
	log_debug "Fetching $PWD directory size"
    dir_size="$(du -sSh --apparent-size | cut -f1)"
	set_input_message "$dir_size"
}

get_dir_count()
{
	local dir_count
	set_input_message "Fetching directory file count..."
	reset_mode
	log_debug "Fetching $PWD directory file count"
	if [[ "$SHOW_HIDDEN" == "1" ]]; then
		dir_count="$(ls -l | wc -l)"
	else
		dir_count="$(ls -lA | wc -l)"
	fi
	set_input_message "$dir_count files"
}

get_dir_maxsize()
{
	local maxsize
	set_input_message "Fetching directory file data..."
	reset_mode
	log_debug "Fetching $PWD directory file data"
	maxsize="$(find . -maxdepth 1 -type f -printf '%s %p\n' \
		| sort -nr \
		| head -1 \
		| awk '{ size=$1; file=$2;
	split("B KB MB GB TB PB",u);
	for(i=1; size>=1024 && i<6; i++) size/=1024;
	printf "%.1f%s %s\n", size, u[i], file }'
	)"
	set_input_message "$maxsize"
}

export_files() {
	export_files_to_csv
	directory_change
}

export_content() {
	export_content_to_txt
	directory_change
}

execute_command()
{
	local tokens=()
	read -ra tokens <<< "$CURRENT_INPUT" 2>/dev/null
	log_debug "Executing command \"${tokens[0]}\", full prompt: \"$CURRENT_INPUT\""
	case "${tokens[0]}" in
		sort) command_sort "${tokens[1]}";;
		mark) mark_file "${tokens[1]}";;
		cp|copy) edit_marked copy "$CURRENT_DIR";;
		mv|move) edit_marked move "$CURRENT_DIR";;
		rm|remove|delete) edit_marked delete;;
		rename) edit_marked rename "${tokens[1]}";;
		create|touch) create_command "${tokens[@]:1}";;
		hidden) command_hidden "${tokens[1]}";;
		q|quit) log_debug "Exiting dora..." exit 0;;
		ds|dirsize) get_dir_size "$CURRENT_DIR";;
		dc|dirsize) get_dir_count "$CURRENT_DIR";;
		ms|maxsize) get_dir_maxsize "$CURRENT_DIR";;
		lw|linewrap) command_line_wrap "${tokens[1]}";;
		ef|export-files) export_files;;
		ec|export-content) export_content;;
		*) set_input_message "$(escape red_color)Command ${tokens[0]} not found$(escape default_color)";;
	esac
	COMMAND_HISTORY+=("$CURRENT_COMMAND")
	CURRENT_COMMAND=""
	reset_mode
}
