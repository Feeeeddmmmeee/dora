#!/usr/bin/env bash

source include/rendering

CURRENT_COMMAND=""
CURRENT_MESSAGE=""

set_command_line_message()
{
	CURRENT_MESSAGE="$1"
	log_debug "Setting message: \"$CURRENT_MESSAGE\""
	render_command
}

enter_command_mode()
{
	log_debug "Entering COMMAND mode"
	MODE="command"
	CURRENT_COMMAND=""
	render_command
}

command_add_character()
{
	CURRENT_COMMAND+="$1"
	render_command
}

command_remove_character()
{
	if [ -z "$CURRENT_COMMAND" ]; then
		reset_mode
		return
	fi
	CURRENT_COMMAND="${CURRENT_COMMAND:0:-1}"
	render_command
}

command_sort() 
{
	local sorting=$1
	case "$sorting" in
		type | size | name | mod) 
			set_command_line_message "Sorting by $sorting"
			set_sorting "$sorting";;
		*) set_command_line_message "$(escape red_color)$sorting is not a supported sorting scheme$(escape default_color)";;
	esac
}

command_hidden()
{
	local arg=$1
	case "$arg" in
		true|1|yes)
			set_command_line_message "Enabled showing .hidden files"
			set_hidden 1
			;;
		false|0|no)
			set_command_line_message "Disabled showing .hidden files"
			set_hidden 0
			;;
		*) set_command_line_message "$(escape red_color)$1 is not a supported boolean alias$(escape default_color)";;
	esac
}

execute_command()
{
	local tokens=()
	read -ra tokens <<< "$CURRENT_COMMAND" 2>/dev/null
	log_debug "Executing command \"${tokens[0]}\", full prompt: \"$CURRENT_COMMAND\""
	case "${tokens[0]}" in
		sort) command_sort "${tokens[1]}";;
		hidden) command_hidden "${tokens[1]}";;
		*) set_command_line_message "$(escape red_color)Command ${tokens[0]} not found$(escape default_color)"
	esac
	reset_mode
}
