#!/usr/bin/env bash

MARKED=
MARKED_DIR=

CURRENT_DIR="$(pwd)/"
SELECTED=0
FILE_LIST_OFFSET=0
CURRENT_DIR_CONTENT=()
SELECTED_CONTENT=
LS_SORTING_FLAGS=()

LS_HIDDEN_FLAGS=(-A)
SHOW_HIDDEN=1

FILE_EDITORS=("$EDITOR" nvim vim vi nano)
HIGHLIGHT_LINE_WRAPPING=0

# Rerenders components which depend on the currently active file
# (except the dir content as its handled separately)
file_change()
{
	render_top
	render_bottom
	update_right_panel_data
	render_right_panel
}

# Rerenders everything without fetching new terminal dimensions 
# and updating variables
directory_change()
{
	clear_file_list
	get_current_dir_content
	render_entire_file_list
	render_top
	render_bottom
	update_right_panel_data
	render_right_panel
}

# Works like directory_change() but doesn't update the current
# directory content
search_change()
{
	SELECTED=0
  FILE_LIST_OFFSET=0
	escape hide_cursor
	clear_file_list
	render_entire_file_list
	render_top
	render_bottom
	update_right_panel_data
	render_right_panel
	if [ "$MODE" = "search" ]; then
		render_input
	fi
}

grep_change()
{
	escape hide_cursor
	if [ "$MODE" = "grep" ]; then
		render_right_panel
		render_input
	fi
}

set_sorting()
{
	init_sorting "$@"
	directory_change
	sync_search_files
	update_search
}

init_sorting()
{
	SORTING=$1
	log_debug "Sorting mode set to: \"$SORTING\"";
	LS_SORTING_FLAGS=()
	case "$SORTING" in
		type) LS_SORTING_FLAGS=(--group-directories-first);;
		size) LS_SORTING_FLAGS=(-S);;
		name) LS_SORTING_FLAGS=();;
		mod) LS_SORTING_FLAGS=(-t);;
	esac
}

set_hidden()
{
	SHOW_HIDDEN=$1
	LS_HIDDEN_FLAGS=()
	if [ "$SHOW_HIDDEN" = "1" ]; then
		LS_HIDDEN_FLAGS=(-A)
	fi
	get_current_dir_content
	sync_search_files
	update_search
}

get_current_dir_content() 
{
	# Load the output of ls into the CURRENT_DIR_CONTENT array
	mapfile -t CURRENT_DIR_CONTENT < <(ls "${LS_HIDDEN_FLAGS[@]}" "${LS_SORTING_FLAGS[@]}" "$CURRENT_DIR")
}

update_selected_content()
{
	local dir_size=${#CURRENT_DIR_CONTENT[@]}
	
	if [[ "$dir_size" = "0" ]]; then
		SELECTED_CONTENT=
		render_selected_content
		return 1
	fi

	local height=$((ROWS - 3))
	local content=
	local selected="$CURRENT_DIR${CURRENT_DIR_CONTENT[$SELECTED]}"

	if [ -d "$selected" ]; then
		local files
		files="$(ls "${LS_HIDDEN_FLAGS[@]}" "${LS_SORTING_FLAGS[@]}" "$selected")"
		content=$(parse_file_list "$(head -"$height" <<< "$files")" "$selected")
	# Don't try to render binary files
	elif file -L -b --mime "$selected" | grep -q binary; then
		content="Can't preview binary file!"
	elif [ -f "$selected" ]; then
		# try to use highlight for preview coloring, if present
		if command -v highlight &> /dev/null; then
			case "$HIGHLIGHT_LINE_WRAPPING" in
				true|1|y|yes)
					content="$(head -"$height" <<< $(highlight -O ansi --line-length="$((COLS/2))" -W --line-range=1-"$height" $selected))";;
				*)
					content="$(highlight -O ansi --line-range=1-"$height" $selected)";;
			esac
		else
			# try to avoid null bytes which apparently mess up strings and most importantly send a random warning
			content="$(head -"$height" "$selected" | tr '\0' '\n')"
		fi
	fi

	SELECTED_CONTENT="$content"
}

update_right_panel_data()
{
	case "$RIGHT_PANEL_MODE" in
		preview) update_selected_content;;
		grep) update_grep_result;;
	esac
}

parse_file_list()
{
	local files=$1
	local dir=$2
	local i=0
	local suffix=
	while IFS= read -r line; do
		get_filetype_color "$dir/$line"
		printf "%b\n" "$line$suffix"
		escape reset
		((i++))
	done <<< "$files"
}

is_file_visible()
{
	# +2 = +1 to account for the top bar, +1 because lines are 1 indexed
	local pos=$(($1-FILE_LIST_OFFSET+2))
	if (( pos > 1 && pos < $((ROWS - 2)) )); then
		return 1;
	fi
	return 0;
}

file_list_move_selection()
{
	local dir_size=${#CURRENT_DIR_CONTENT[@]}
	
	if [[ "$dir_size" = "0" ]]; then
		return 1
	fi

	local jump_size=${1:-1}
	local prev="$SELECTED"
	((SELECTED+=jump_size))

	if (( SELECTED >= dir_size )); then
		SELECTED=$((dir_size - 1))
		jump_size=$((SELECTED - prev))
	fi
	if (( SELECTED < 0 )); then
		SELECTED=0
		jump_size=$((SELECTED - prev))
	fi

	# Don't rerender components if the selected file didn't change
	if [[ "$jump_size" = "0" ]]; then
		return 0
	fi

	if is_file_visible $SELECTED; then
		local offa offb

		# Make sure offset isn't out of bounds
		offb=$((dir_size - ROWS + 4))
		offa=$((FILE_LIST_OFFSET + jump_size))
		FILE_LIST_OFFSET=$((offa>offb ? offb : offa))
		FILE_LIST_OFFSET=$((FILE_LIST_OFFSET>0 ?FILE_LIST_OFFSET : 0))

		render_entire_file_list
	else
		render_file_list_entry $SELECTED
		render_file_list_entry $prev
	fi

	file_change
}

file_list_open()
{
	local dest="${1:-$CURRENT_DIR${CURRENT_DIR_CONTENT[$SELECTED]}}"
	reset_search

	if [[ -d "$dest" ]]; then
		cd "$dest" &>/dev/null && log_debug "Going to $dest" || \
			{ 
				log_debug "Going to $dest failed" 
				set_command_line_message "$(escape red_color)Failed to open $dest$(escape default_color)"
			}
		CURRENT_DIR="$(pwd)/"

		if [[ "$CURRENT_DIR" == "//" ]]; then
			CURRENT_DIR="/"
		fi

		SELECTED=0
		FILE_LIST_OFFSET=0
		directory_change
	else
		# Try to open binary files with xdg-open
		if file -L -b --mime "$dest" | grep -q binary; then
			if command -v xdg-open $> /dev/null; then
				xdg-open "$dest" &
			fi
		# Else open it in the same terminal in a text editor
		else
			# Kill the keyboard input process
			kill %%
			# Other TUI programs often overwrite the stored terminal
			escape restore_term

			for cmd in "${FILE_EDITORS[@]}"; do
				[[ -z "$cmd" ]] && continue
				if command -v "$cmd" &>/dev/null; then
					"$cmd" "$dest"
					break
				fi
			done

			# Restart keyboard input
			handle_keyboard_input <&$fd2 &
			escape save_term
			escape hide_cursor
			redraw
		fi
	fi
}

open_terminal_in_dir() 
{
  kill %%
		
  escape clear
  escape set_cursor

  local current_dir="$CURRENT_DIR"
  cd "$1"
  "$SHELL"
  cd "$current_dir"

  handle_keyboard_input <&$fd2 &
  escape hide_cursor
  redraw
}
