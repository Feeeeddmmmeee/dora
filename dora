#!/usr/bin/env bash

# Different include path for local developement and final installation
LOCAL_INCLUDE="include"
SYSTEM_INCLUDE="/usr/share/dora"

if [ -d "$SYSTEM_INCLUDE" ]; then
	INCLUDE_DIR="$SYSTEM_INCLUDE"
else
	INCLUDE_DIR="$LOCAL_INCLUDE"
fi

source "$INCLUDE_DIR/logging"
source "$INCLUDE_DIR/rendering"
source "$INCLUDE_DIR/help"
source "$INCLUDE_DIR/grep"
source "$INCLUDE_DIR/navigation"
source "$INCLUDE_DIR/command"
source "$INCLUDE_DIR/search"

# type, mod, name, size
init_sorting "type"
PIPE=

# normal, command, search, grep
MODE="normal" 
CURRENT_INPUT=""
CURRENT_MESSAGE=""

# preview, grep
RIGHT_PANEL_MODE="preview"

enter_preview_mode()
{
	RIGHT_PANEL_MODE="preview"
	update_right_panel_data
	render_right_panel
}

execute_input()
{
	case "$MODE" in
		command) execute_command;;
		search) reset_mode;;
		grep) reset_mode;;
	esac
}

set_input_message()
{
	CURRENT_MESSAGE="$1"
	log_debug "Setting message: \"$CURRENT_MESSAGE\""
	render_input
}

add_character()
{
	CURRENT_INPUT+="$1"
	escape hide_cursor
	render_input
	escape show_cursor

	case "$MODE" in
		search) 
			SEARCH_QUERY="$CURRENT_INPUT"
			update_search;;
		grep)
			GREP_PATTERN="$CURRENT_INPUT"
			update_grep_result;;
		command)
			CURRENT_COMMAND="$CURRENT_INPUT"
			update_command_draft;;
	esac
}

remove_character()
{
	if [ -z "$CURRENT_INPUT" ]; then
		exit_input
		return
	fi

	CURRENT_INPUT="${CURRENT_INPUT:0:-1}"
	escape hide_cursor
	render_input
	escape show_cursor

	case "$MODE" in
		search) 
			SEARCH_QUERY="$CURRENT_INPUT"
			update_search;;
		grep)
			GREP_PATTERN="$CURRENT_INPUT"
			update_grep_result;;
		command)
			CURRENT_COMMAND="$CURRENT_INPUT"
			update_command_draft;;
	esac
}

reset_mode() {
	log_debug "Entering NORMAL mode"
	MODE="normal"
	render_input
	escape cursor_disable_blinking
	escape hide_cursor
}

fatal()
{
	log_error "$*"
	exit 1
}

cleanup()
{
	escape restore_term
	escape show_cursor
	escape reset
	tput rmcup
	tput smam
	rm $PIPE
	kill %% 2>/dev/null
}

handle_keyboard_input()
{
	while true; do
		# Handling Input
		local input=""
		IFS= read -rsn1  input 2>/dev/null || return
		# Read 2 chars if first char is an escape charcter (to handle arrow keys)
		if [[ $input == $'\x1b' ]]; then
			local rest=""
			while IFS= read -rsn1 -t 0.01 char 2>/dev/null; do
				rest+="$char"
			done
			if [[ -n "$rest" ]]; then
				input="$rest"
			else
				input="ESCAPE"
			fi
		elif [[ $input = $'\x08' || $input = $'\x7f' ]]; then
			input="BACKSPACE"
		elif [[ $input = " " ]]; then
			input=" "
		elif [[ $input = $'\x15' ]]; then
			input="CTRL-U"
		elif [[ $input = $'\x04' ]]; then
			input="CTRL-D"
		fi

		if [[ -n "$input" ]]; then
			echo "$input" >&$fd
		else
			echo "RETURN" >&$fd
		fi
	done
}

exit_input()
{
	CURRENT_MESSAGE=""
	escape hide_cursor
	case "$MODE" in
		search) 
			reset_search
			directory_change
			;;
		grep)
			reset_grep
			;;
	esac
	reset_mode
}

main()
{
	# Init logging
	mkdir -p "$LOG_DIR" || fatal "Failed to init logging directory"

	# Parse command line options
	ARGS=()
	while [[ $# -gt 0 ]]; do
		case $1 in
			-h|--help) 
				show_help
				exit 0 ;;
			-l|--logs)
				show_logs
				exit 0 ;;
			-*)
				echo "Unknown option: $1"
				fatal "Unknown option: $1"
				;;
			*)
				ARGS+=("$1")
				shift
				;;
		esac
	done

	tput smcup
	tput rmam
	# Prepare terminal for rendering
	trap cleanup exit

	escape save_term
	escape hide_cursor
	escape clear
	redraw

	# Try to cd into directory if provided with one
	set -- "${ARGS[@]}"
	if [[ -n $1 ]]; then
		file_list_open "$1"
	fi

	# Setup named pipes for communication
	PIPE=/tmp/dora_keyboard_input_$$
	mkfifo $PIPE
	exec {fd}<>$PIPE
	exec 2>"$LOG_FILE"

	exec {fd2}</dev/tty
	handle_keyboard_input <&$fd2 &

	# Handle events
	while true; do
		IFS="" read -r -t 0.1 input <&$fd

		local old_rows=$ROWS
		local old_cols=$COLS
		get_term_size

		if [[ "$old_rows" -ne "$ROWS" || "$old_cols" -ne "$COLS" ]]; then
			redraw
		fi

		if [[ -z "$input" ]]; then
			continue
		fi

		case "$MODE" in
			normal)
				case "$input" in
					'[A' | k) file_list_move_selection -1;;
					'[B' | j) file_list_move_selection 1;;
					'CTRL-U') file_list_move_selection $(((ROWS - 3)/-2));;
					'CTRL-D') file_list_move_selection $(((ROWS - 3)/2));;
					'g') file_list_move_selection "$((-1*${#CURRENT_DIR_CONTENT[@]}))";;
					'G') file_list_move_selection "${#CURRENT_DIR_CONTENT[@]}";;
					'~') file_list_open "$HOME";;
					'[C' | l) file_list_open;;
					'[D' | h | -) file_list_open ..;;
					'RETURN') file_list_open;;
					':') enter_command_mode;;
					'/') enter_search_mode;;
					' ') mark_file;;
					'c') edit_marked copy "$CURRENT_DIR";;
					'm') edit_marked move "$CURRENT_DIR";;
					'd') edit_marked delete;;
					'x') edit_marked toggle_executable;;
					't') start_command "create ";;
					'r') start_command "rename $MARKED";;
					'?') enter_grep_mode;;
					'.') command_hidden;;
					q) exit;;
				esac;;
			command)
				case "$input" in
					'[A') move_command_history -1;;
					'[B') move_command_history 1;;
					'ESCAPE') exit_input;;
					'BACKSPACE') remove_character;;
					'RETURN') execute_input;;
					*) add_character "$input";;
				esac;;
			*)
				case "$input" in
					'ESCAPE') exit_input;;
					'BACKSPACE') remove_character;;
					'RETURN') execute_input;;
					*) add_character "$input";;
				esac;;
		esac
	done
}

main "$@"
