#!/usr/bin/env bash

source include/help
source include/navigation

# type, mod, name, size
init_sorting "type"

SHOW_HIDDEN=
PIPE=

# normal, command
MODE="normal"

CURRENT_COMMAND=""

fatal()
{
	log_error "$*"
	exit 1
}

cleanup()
{
	escape restore_term
	escape show_cursor
	escape reset
	rm $PIPE
	kill %% 2>/dev/null
}

handle_keyboard_input()
{
	while true; do
		# Handling Input
		local input=""
		read -rsn1  input 2>/dev/null || return
		# Read 2 chars if first char is an escape charcter (to handle arrow keys)
		if [[ $input == $'\u1b' ]]; then
			local rest=""
			while IFS= read -rsn1 -t 0.01 char 2>/dev/null; do
        rest+="$char"
      done
			if [[ -n "$rest" ]]; then
				input="$rest"
			else
				input="ESC"
			fi
		fi

		if [[ -n "$input" ]]; then
			echo $input >&$fd
		else
			# SpaceEnter
			echo "BLANK" >&$fd
		fi
	done
}

main()
{
	# Init logging
	mkdir -p "$LOG_DIR" || fatal "Failed to init logging directory"

	# Parse command line options
	ARGS=()
	while [[ $# -gt 0 ]]; do
		case $1 in
			-h|--help) 
				show_help
				exit 0 ;;
			-l|--logs)
				show_logs
				exit 0 ;;
			-*)
				echo "Unknown option: $1"
				fatal "Unknown option: $1"
				;;
			*)
				ARGS+=("$1")
				shift
				;;
		esac
	done

	# Prepare terminal for rendering
	trap cleanup exit

	escape save_term
	escape hide_cursor
	escape clear
	redraw

	# Try to cd into directory if provided with one
	set -- "${ARGS[@]}"
	if [[ -n $1 ]]; then
		file_list_open "$1"
	fi

	# Setup named pipes for communication
	PIPE=/tmp/dora_keyboard_input_$$
	mkfifo $PIPE
	exec {fd}<>$PIPE

	exec {fd2}</dev/tty
	handle_keyboard_input <&$fd2 &

	# Handle events
	while true; do
		read -r -t 0.1 input <&$fd

		local old_rows=$ROWS
		local old_cols=$COLS
		get_term_size

		if [[ "$old_rows" -ne "$ROWS" || "$old_cols" -ne "$COLS" ]]; then
			redraw
		fi

		if [[ -z "$input" ]]; then
			continue
		fi

		log_debug "$input"

		case "$MODE" in
			normal)
				case "$input" in
					'[A' | k) file_list_move_up;;
					'[B' | j) file_list_move_down;;
					'[C' | l) file_list_open;;
					'[D' | h | -) file_list_open ..;;
					'BLANK') file_list_open;;
					':') start_command;;
					q) exit;;
				esac;;
			command)
				case "$input" in
					'ESC') reset_mode;;
					*) 
						CURRENT_COMMAND+="$input"
						render_command
				esac;;
		esac
	done
}

main "$@"
