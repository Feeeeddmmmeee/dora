#!/usr/bin/env bash

escape()
{
	case "$1" in
		clear) printf '\e[2J';;
		save_term) printf '\e[?1049h';;
		restore_term) printf '\e[?1049l';;
	esac
}

cleanup()
{
	escape restore_term
}

get_term_size()
{
	read -r LINES COLUMNS < <(stty size)
}

main()
{
	trap cleanup exit
	trap 'get_term_size' WINCH
	get_term_size

	escape save_term
	escape clear

	# Placeholder event loop
	while true; do
		true
	done
}

main "$@"
