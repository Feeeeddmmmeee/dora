#!/usr/bin/env bash

source include/help
source include/navigation

# type, mod, name, size
init_sorting "type"

SHOW_HIDDEN=
PIPE=

fatal()
{
	log_error "$*"
	exit 1
}

cleanup()
{
	escape restore_term
	escape show_cursor
	escape reset
	rm $PIPE
	kill %% 2>/dev/null
}

handle_keyboard_input()
{
	while true; do
		# Handling Input
		local input=""
		read -rsn1  input 2>/dev/null || return
		# Read 2 chars if first char is an escape charcter (to handle arrow keys)
		if [[ $input == $'\u1b' ]]; then
			read -rsn2 input 2>/dev/null || return
		fi

		local output=''
		case "$input" in
			'[A' | k) output='cursor_up';;
			'[B' | j) output='cursor_down';;
			'[C' | l) output='enter_dir';;
			'[D' | h | -) output='exit_dir';;
			'') output='enter';;
			q) output='quit';;
		esac

		if [[ -n $output ]]; then
			echo $output >&$fd
		fi
	done
}

main()
{
	# Init logging
	mkdir -p "$LOG_DIR" || fatal "Failed to init logging directory"

	# Parse command line options
	ARGS=()
	while [[ $# -gt 0 ]]; do
		case $1 in
			-h|--help) 
				show_help
				exit 0 ;;
			-l|--logs)
				show_logs
				exit 0 ;;
			-*)
				echo "Unknown option: $1"
				fatal "Unknown option: $1"
				;;
			*)
				ARGS+=("$1")
				shift
				;;
		esac
	done

	# Prepare terminal for rendering
	trap cleanup exit

	escape save_term
	escape hide_cursor
	escape clear

	trap redraw SIGWINCH
	redraw

	# Try to cd into directory if provided with one
	set -- "${ARGS[@]}"
	if [[ -n $1 ]]; then
		file_list_open "$1"
	fi

	# Setup named pipes for communication
	PIPE=/tmp/dora_keyboard_input_$$
	mkfifo $PIPE
	exec {fd}<>$PIPE

	exec {fd2}</dev/tty
	handle_keyboard_input <&$fd2 &

	# Handle events
	while true; do
		read -r -t 0.1 input <&$fd

		local old_rows=$ROWS
		local old_cols=$COLS
		get_term_size

		if [[ "$old_rows" -ne "$ROWS" || "$old_cols" -ne "$COLS" ]]; then
			redraw
		fi

		case "$input" in
			cursor_up) file_list_move_selection -1;;
			cursor_down) file_list_move_selection 1;;
			enter_dir) file_list_open;;
			exit_dir) file_list_open .. ;;
			enter) file_list_open;;
			quit) exit;;
		esac
	done
}

main "$@"
