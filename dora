#!/usr/bin/env bash

PIPE=
SELECTED=0
ROWS=
COLS=
CURRENT=(
	"$(pwd)"
)

escape()
{
	case "$1" in
		clear) printf "\e[2J";;
		save_term) printf "\e[?1049h";;
		restore_term) printf "\e[?1049l";;
		save_cursor) printf "\e7";;
		restore_cursor) printf "\e8";;
		move_cursor_up) printf "\e[%sA" "${2:-1}";;
		move_cursor_down) printf "\e[%sB" "${2:-1}";;
		set_cursor) printf "\e[%s;%sH" "${2:-0}" "${3:-0}";; # row, col
		hide_cursor) printf "\e[?25l";;
		show_cursor) printf "\e[?25h";;
		reset) printf "\e[0m";;
	esac
}

cleanup()
{
	escape restore_term
	escape show_cursor
	escape reset
	rm $PIPE
	kill %%
}

get_term_size()
{
	ROWS=$(tput lines)
	COLS=$(tput cols)
}

render_bottom()
{
	escape set_cursor "$ROWS" 0
	local selected=${CURRENT[SELECTED]}
	printf "%s" "$(stat -c "%A %G " "$selected")"
	printf "%s" "$(format_bytes "$(stat -c "%s" "$selected")") "
	printf "%s" "$(date -d "$(stat -c "%z" "$selected")" +'%Y-%m-%d %H:%M')"
}

render_top()
{
	escape set_cursor
	local selected=${CURRENT[SELECTED]}
	printf "%s" "$(whoami)@$(uname -n) "
	printf "%s" "$selected"
}

format_bytes()
{
	local bytes=$1
	local units=("B" "KiB" "MiB" "GiB" "TiB")
	local i=0

	while (( bytes >= 1024 && i < ${#units[@]} - 1 )); do
		bytes=$(( bytes / 1024 ))
		((i++))
	done

	echo "${bytes}${units[$i]}"
}

redraw()
{
	get_term_size

	escape clear
	render_top
	render_bottom
}

handle_keyboard_input()
{
	while true; do
		# Handling Input
		local input=""
		read -rsn1  input 2>/dev/null || return
		# Read 2 chars if first char is an escape charcter (to handle arrow keys)
		if [[ $input == $'\u1b' ]]; then
			read -rsn2 input 2>/dev/null || return
		fi

		local output=''
		case "$input" in
			'[A' | k) output='cursor_up';;
			'[B' | j) output='cursor_down';;
			'') output='enter';;
			q) output='quit';;
		esac

		if [[ -n $output ]]; then
			echo $output >&$fd
		fi
	done
}

main()
{
	trap cleanup exit

	escape save_term
	escape hide_cursor
	escape clear

	trap redraw SIGWINCH
	redraw

	PIPE=/tmp/dora_keyboard_input_$$
	mkfifo $PIPE
	exec {fd}<>$PIPE

	exec {fd2}</dev/tty
	handle_keyboard_input <&$fd2 &

	# Handle events
	while true; do
		read -r -t 0.5 input <&$fd

		case "$input" in
			quit) exit;;
		esac
	done
}

main "$@"
