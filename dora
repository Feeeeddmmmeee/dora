#!/usr/bin/env bash

source include/logging
source include/help

SHOW_HIDDEN=
PIPE=
SELECTED=0
ROWS=
COLS=
FILE_LIST_OFFSET=0
CURRENT_DIR="$(pwd)/"
CURRENT_DIR_CONTENT=()
SELECTED_CONTENT=

# type, mod, name, size
SORTING="type"

fatal()
{
	log_error "$*"
	exit 1
}

escape()
{
	case "$1" in
		clear) printf "\e[2J";;
		save_term) printf "\e[?1049h";;
		restore_term) printf "\e[?1049l";;
		save_cursor) printf "\e7";;
		restore_cursor) printf "\e8";;
		move_cursor_up) printf "\e[%sA" "${2:-1}";;
		move_cursor_down) printf "\e[%sB" "${2:-1}";;
		set_cursor) printf "\e[%s;%sH" "${2:-1}" "${3:-1}";; # row, col
		hide_cursor) printf "\e[?25l";;
		show_cursor) printf "\e[?25h";;
		reset) printf "\e[0m";;
		erase_line_to_cursor) printf "\e[1K";;
		erase_cursor_to_end) printf "\e[0K";;
		invert_color) printf "\e[7m";;
		reinvert_color) printf "\e[27m";;
		black_color) printf "\e[30m";;
		red_color) printf "\e[31m";;
		green_color) printf "\e[32m";;
		yellow_color) printf "\e[33m";;
		blue_color) printf "\e[34m";;
		magenta_color) printf "\e[35m";;
		cyan_color) printf "\e[36m";;
		white_color) printf "\e[37m";;
		default_color) printf "\e[39m";;
		black_bg_color) printf "\e[40m";;
		red_bg_color) printf "\e[41m";;
		green_bg_color) printf "\e[42m";;
		yellow_bg_color) printf "\e[43m";;
		blue_bg_color) printf "\e[44m";;
		magenta_bg_color) printf "\e[45m";;
		cyan_bg_color) printf "\e[46m";;
		white_bg_color) printf "\e[47m";;
		default_bg_color) printf "\e[49m";;
		dim) printf "\e[2m";;
		undim) printf "\e[22m";;
	esac
}

cleanup()
{
	escape restore_term
	escape show_cursor
	escape reset
	rm $PIPE
	kill %% 2>/dev/null
}

get_term_size()
{
	ROWS=$(tput lines)
	COLS=$(tput cols)
}

justify_to_term_width()
{
	local left=$1
	local right=$2

	local left_no_escape right_no_escape
	left_no_escape=$(sed 's/\x1B\[[0-9;]\{1,\}[A-Za-z]//g' <<< "$left")
	right_no_escape=$(sed 's/\x1B\[[0-9;]\{1,\}[A-Za-z]//g' <<< "$right")

	local len=$((COLS - ${#left_no_escape} - ${#right_no_escape}))
	spaces=$(printf "%${len}s" "")
	printf "%s" "$left$spaces$right"
}

render_bottom()
{
	local file_info spaces selected dir_info index

	escape set_cursor "$((ROWS - 1))" 0
	if (( ${#CURRENT_DIR_CONTENT[@]} )); then
		selected=${CURRENT_DIR_CONTENT[SELECTED]}

		file_info="$(stat -c "%A %G " "$selected")"
		file_info="$file_info$(format_bytes "$(stat -c "%s" "$selected")") "
		file_info="$file_info$(date -d "$(stat -c "%z" "$selected")" +'%Y-%m-%d %H:%M') $(escape reset)"
		index="($((SELECTED + 1))/${#CURRENT_DIR_CONTENT[@]})"
	else
		file_info="$(escape reset)"
		index="(0/0)"
	fi

	dir_info="$(escape blue_color)$(escape invert_color)$index"

	justify_to_term_width "$dir_info" "$file_info"
}


render_top()
{
	escape set_cursor
	local selected dims
	selected="$(escape blue_color)$CURRENT_DIR$(escape white_color)${CURRENT_DIR_CONTENT[SELECTED]}"
	dims="$ROWS x $COLS"

	justify_to_term_width "$(escape green_color)$(whoami)@$(uname -n)$(escape white_color) $selected" "$dims"
}

get_current_dir_content() 
{
	CURRENT_DIR_CONTENT=($(ls -A "$CURRENT_DIR"))
	case "$SORTING" in
		type) CURRENT_DIR_CONTENT=($(ls -A --group-directories-first));;
		size) CURRENT_DIR_CONTENT=($(ls -AS "$CURRENT_DIR"));;
		name) CURRENT_DIR_CONTENT=($(ls -A "$CURRENT_DIR"));;
		mod) CURRENT_DIR_CONTENT=($(ls -At "$CURRENT_DIR"));;
	esac
}

clear_file_list()
{
	for (( i=2; i < $((ROWS-1)); i++ )); do
		escape set_cursor $i $((COLS/2))
		escape erase_line_to_cursor
	done
}

is_file_visible()
{
	local pos=$(($1-FILE_LIST_OFFSET+2))
	if (( pos	>= 2 && pos < $((ROWS-1)) )); then
		return 1;
	fi
	return 0;
}

render_file_list_entry()
{
	local id=$1
	local pos=$((id-FILE_LIST_OFFSET+2))
	is_file_visible "$id"
	local visible=$?
	if [[ "$visible" = "1" ]]; then
		escape set_cursor $pos
		if (( id == SELECTED )); then
			escape invert_color
		fi
		local element=${CURRENT_DIR_CONTENT[$id]}
		local global_element="$CURRENT_DIR$element"
		if [[	-d "$global_element" ]]; then
			escape blue_color
		elif [[	-L "$global_element" ]]; then
			escape cyan_color
		elif [[	-f "$global_element" ]]; then
			escape default_color
			if [[	-x "$global_element" ]]; then
				escape green_color
			fi
		elif [[	-b "$global_element" ]]; then
			escape yellow_color
		elif [[	-c "$global_element" ]]; then
			escape magenta_color
		else
			escape dim
			escape white_color
		fi
		printf "%-$((COLS/2 - 1))s" " $element"
		escape reset
	fi
}

render_entire_file_list()
{
	local iter=0
	for element in "${CURRENT_DIR_CONTENT[@]}"; do
		render_file_list_entry $iter
		((iter+=1))
	done
}

set_sorting()
{
	SORTING=$1
	get_current_dir_content
	render_entire_file_list
	update_selected_content
}

file_list_move_up()
{
	((SELECTED-=1))
	if (( SELECTED < 0 )); then
		SELECTED=0
	fi
	is_file_visible $SELECTED
	local visible=$?
	if [[ "$visible" ==	"0" ]]; then
		FILE_LIST_OFFSET=$(( FILE_LIST_OFFSET - 1	))
		render_entire_file_list
	else
		render_file_list_entry $SELECTED
		render_file_list_entry $((SELECTED+1))
	fi
	render_bottom
	render_top
	update_selected_content
}

file_list_move_down()
{
	((SELECTED+=1))
	if (( SELECTED >= ${#CURRENT_DIR_CONTENT[@]} )); then
		SELECTED=$((${#CURRENT_DIR_CONTENT[@]} - 1))
	fi
	is_file_visible $SELECTED
	local visible=$?
	if [[ "$visible" ==	"0" ]]; then
		FILE_LIST_OFFSET=$(( FILE_LIST_OFFSET + 1	))
		render_entire_file_list
	else
		render_file_list_entry $SELECTED
		render_file_list_entry $((SELECTED-1))
	fi
	render_bottom
	render_top
	update_selected_content
}

file_list_open()
{
	local dest="${1:-$CURRENT_DIR${CURRENT_DIR_CONTENT[$SELECTED]}}"
	log_debug "Opening $dest"

	if [[ -d "$dest" ]]; then
		cd "$dest" &>/dev/null || fatal "Failed to open $dest"
		CURRENT_DIR="$(pwd)/"
		if [[ "$CURRENT_DIR" == "//" ]]; then
			CURRENT_DIR="/"
		fi
		SELECTED=0
		FILE_LIST_OFFSET=0
		clear_file_list
		get_current_dir_content
		render_entire_file_list
		render_top
		render_bottom
		update_selected_content
	fi
}

render_selected_content()
{
	local mid=$(((COLS/2)+1))
	local i=2
	local maxlen=$((COLS - mid - 1))

	for j in $(seq 2 $((ROWS-2))); do
		escape set_cursor "$j" "$mid"
		escape erase_cursor_to_end
	done

	while IFS= read -r line; do
		escape set_cursor $i "$mid"
		line="${line//$'\t'/    }"
		printf "%s" "${line:0:maxlen}"
		((i++))
	done <<< "$SELECTED_CONTENT"
}

update_selected_content()
{
	local height=$((ROWS - 3))
	local content=
	local selected="$CURRENT_DIR${CURRENT_DIR_CONTENT[$SELECTED]}"

	# tr to avoid null bytes which apparently mess up strings and most importantly send a random warning
	if [[ -f $selected ]]; then
		content="$(head -"$height" "$selected" | tr '\0' '\n')"
	fi

	if [[ -d selected ]]; then
		true
	fi

	SELECTED_CONTENT=$content
	render_selected_content
}

format_bytes()
{
	local bytes=$1
	local units=("B" "KiB" "MiB" "GiB" "TiB")
	local i=0

	while (( bytes >= 1024 && i < ${#units[@]} - 1 )); do
		bytes=$(( bytes / 1024 ))
		((i++))
	done

	echo "${bytes}${units[$i]}"
}

redraw()
{
	get_term_size

	escape clear
	get_current_dir_content
	SELECTED=0
	render_entire_file_list
	render_top
	render_bottom
	update_selected_content
}

handle_keyboard_input()
{
	while true; do
		# Handling Input
		local input=""
		read -rsn1  input 2>/dev/null || return
		# Read 2 chars if first char is an escape charcter (to handle arrow keys)
		if [[ $input == $'\u1b' ]]; then
			read -rsn2 input 2>/dev/null || return
		fi

		local output=''
		case "$input" in
			'[A' | k) output='cursor_up';;
			'[B' | j) output='cursor_down';;
			'[C' | l) output='enter_dir';;
			'[D' | h | -) output='exit_dir';;
			'') output='enter';;
			q) output='quit';;
		esac

		if [[ -n $output ]]; then
			echo $output >&$fd
		fi
	done
}

main()
{
	# Init logging
	mkdir -p "$LOG_DIR" || fatal "Failed to init logging directory"

	# Parse command line options
	ARGS=()
	while [[ $# -gt 0 ]]; do
		case $1 in
			-h|--help) 
				show_help
				exit 0 ;;
			-l|--logs)
				show_logs
				exit 0 ;;
			-*)
				echo "Unknown option: $1"
				fatal "Unknown option: $1"
				;;
			*)
				ARGS+=("$1")
				shift
				;;
		esac
	done

	# Prepare terminal for rendering
	trap cleanup exit

	escape save_term
	escape hide_cursor
	escape clear

	trap redraw SIGWINCH
	redraw

	# Try to cd into directory if provided with one
	set -- "${ARGS[@]}"
	if [[ -n $1 ]]; then
		file_list_open "$1"
	fi

	# Setup named pipes for communication
	PIPE=/tmp/dora_keyboard_input_$$
	mkfifo $PIPE
	exec {fd}<>$PIPE

	exec {fd2}</dev/tty
	handle_keyboard_input <&$fd2 &

	# Handle events
	while true; do
		read -r -t 0.1 input <&$fd

		local old_rows=$ROWS
		local old_cols=$COLS
		get_term_size

		if [[ "$old_rows" -ne "$ROWS" || "$old_cols" -ne "$COLS" ]]; then
			redraw
		fi

		case "$input" in
			cursor_up) file_list_move_up;;
			cursor_down) file_list_move_down;;
			enter_dir) file_list_open;;
			exit_dir) file_list_open .. ;;
			enter) file_list_open;;
			quit) exit;;
		esac
	done
}

main "$@"
